{
  "name": "qrmenu",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node --env-file-if-exists=.env node_modules/prisma/build/index.js generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test --test-isolation=none tests/permissions.test.mjs tests/validation.test.mjs tests/service-security.test.mjs tests/media.test.mjs tests/database-cache.test.mjs tests/ordering.test.mjs",
    "test:db": "node --env-file=.env --test --test-isolation=none tests/*.test.mjs",
    "test:browser": "node --env-file=.env scripts/browser-check.mjs",
    "db:inspect": "node --env-file=.env scripts/inspect-database.mjs",
    "db:validate": "node --env-file-if-exists=.env node_modules/prisma/build/index.js validate",
    "db:generate": "node --env-file-if-exists=.env node_modules/prisma/build/index.js generate",
    "db:status": "node --env-file=.env node_modules/prisma/build/index.js migrate status",
    "check:secrets": "node --env-file=.env scripts/check-client-secrets.mjs",
    "prebuild": "node --env-file-if-exists=.env node_modules/prisma/build/index.js generate"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-auth": "^1.7.11",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "pdf-parse": "^2.4.5",
    "playwright-core": "^1.64.1",
    "prisma": "^7.10.1",
    "tailwindcss": "^4"
  }
}
